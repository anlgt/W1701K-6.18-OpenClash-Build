Subject: [PATCH] luci: report missing telemetry honestly and discover PHY hwmon by device

Read EN8811H hwmon devices through their parent PHY device, retain null
for failed/missing temperatures, and preserve valid zero-degree readings.
Show PLL measurement if CPUFreq is absent without inventing a governor.

--- a/package/luci-app-w1700k-fancontrol/root/usr/libexec/rpcd/luci.fan
+++ b/package/luci-app-w1700k-fancontrol/root/usr/libexec/rpcd/luci.fan
@@ -37,6 +37,10 @@
 		if [ -f "$hwmon/name" ]; then
 			local name=$(cat "$hwmon/name" 2>/dev/null)
 			case "$name" in
+				*"$suffix") echo "$hwmon"; return ;;
+			esac
+			local device=$(readlink -f "$hwmon/device" 2>/dev/null)
+			case "$device" in
 				*"$suffix")
 					echo "$hwmon"
 					return
@@ -50,14 +54,17 @@
 HWMON=$(find_nct7802)
 
 read_temp() {
-	local file="$1"
-	local temp=0
-	if [ -f "$file" ]; then
-		temp=$(cat "$file" 2>/dev/null || echo 0)
-		# Convert from milli-celsius to celsius
-		temp=$((temp / 1000))
-	fi
-	echo "$temp"
+	local file="$1" temp
+	if [ ! -r "$file" ]; then
+		echo null
+		return
+	fi
+	temp=$(cat "$file" 2>/dev/null) || { echo null; return; }
+	if ! printf '%s\n' "$temp" | grep -Eq '^-?[0-9]+$'; then
+		echo null
+		return
+	fi
+	echo $((temp / 1000))
 }
 
 read_value() {
@@ -93,8 +100,8 @@
 
 	local phy1_hwmon=$(find_phy_hwmon "$phy_lan_suffix")
 	local phy2_hwmon=$(find_phy_hwmon "$phy_wan_suffix")
-	temp_phy1=$([ -n "$phy1_hwmon" ] && read_temp "$phy1_hwmon/temp1_input" || echo 0)
-	temp_phy2=$([ -n "$phy2_hwmon" ] && read_temp "$phy2_hwmon/temp1_input" || echo 0)
+	temp_phy1=$([ -n "$phy1_hwmon" ] && read_temp "$phy1_hwmon/temp1_input" || echo null)
+	temp_phy2=$([ -n "$phy2_hwmon" ] && read_temp "$phy2_hwmon/temp1_input" || echo null)
 
 	# Read fan status
 	fan_rpm=$(read_value "${HWMON}/fan1_input")
@@ -105,7 +112,7 @@
 	fan_percentage=$((fan_pwm * 100 / 255))
 
 	# Get WiFi temperatures from mt7996 hwmon devices (dynamic lookup)
-	local wifi_24g=0 wifi_5g=0 wifi_6g=0
+	local wifi_24g=null wifi_5g=null wifi_6g=null
 	local wifi_24g_hwmon=$(find_mt7996_hwmon 0)
 	local wifi_5g_hwmon=$(find_mt7996_hwmon 1)
 	local wifi_6g_hwmon=$(find_mt7996_hwmon 2)
@@ -128,7 +135,7 @@
