CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_xr1710g-ubi=y

# Build only the flashable XR1710G sysupgrade ITB.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# This OpenWrt 6.18 snapshot uses APK internally. The package manager UI is
# intentionally omitted because this custom kernel has no matching public kmod
# repository.
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_PACKAGE_apk-mbedtls=y
# CONFIG_PACKAGE_apk-openssl is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set

# Minimal LuCI stack, Simplified Chinese and Argon as the only theme.
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_PACKAGE_luci is not set
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_luci-theme-glass is not set

# Web server and LuCI RPC backends.
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_px5g-mbedtls=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# UPnP/NAT-PMP. It remains disabled until the user enables it in LuCI.
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_miniupnpd-iptables is not set

# OpenClash 0.47.156 with nftables dependencies.
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_LIBCURL_OPENSSL=y
# CONFIG_LIBCURL_MBEDTLS is not set
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y

# IRQ balancing.
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_luci-i18n-irqbalance-zh-cn=y

# Community XR1710G Airoha SoC Status and NCT7802 fan-control packages.
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
CONFIG_PACKAGE_luci-app-airoha-fancontrol=y
CONFIG_PACKAGE_luci-i18n-airoha-fancontrol-zh-cn=y

# XR1710G hardware runtime. These are not optional applications.
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_kmod-airoha-eth=y
CONFIG_PACKAGE_kmod-airoha-npu=y
CONFIG_PACKAGE_kmod-hwmon-nct7802=y
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_rtl826x-firmware=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# Normal router operation.
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# Remove optional applications inherited from the upstream device profile.
# CONFIG_PACKAGE_ethtool-full is not set
# CONFIG_PACKAGE_iperf3 is not set
# CONFIG_PACKAGE_kmod-airoha-net-debug is not set
# CONFIG_PACKAGE_luci-app-airoha-flowsense is not set
# CONFIG_PACKAGE_luci-app-mlo is not set
# CONFIG_PACKAGE_luci-i18n-glass-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-mlo-zh-cn is not set
# CONFIG_PACKAGE_mdio-tools is not set
# CONFIG_PACKAGE_openssh-sftp-server is not set
# CONFIG_PACKAGE_phytool is not set
# CONFIG_PACKAGE_tcpdump is not set

# Explicitly exclude WireGuard support and its LuCI protocol page.
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
