#!/bin/sh

. /lib/functions/system.sh

[ "$(board_name)" = "gemtek,xr1710g-ubi" ] || exit 0

# Use Simplified Chinese and Argon from the first LuCI login.
uci -q set luci.languages.zh_cn='简体中文 (Simplified Chinese)' || exit 1
uci -q set luci.main.lang='zh_cn' || exit 1
uci -q set luci.main.mediaurlbase='/luci-static/argon' || exit 1
uci -q commit luci || exit 1

# Distribute hardware interrupts over all four AN7581 CPU cores.
uci -q set irqbalance.irqbalance.enabled='1' || exit 1
uci -q commit irqbalance || exit 1
if [ -x /etc/init.d/irqbalance ]; then
	/etc/init.d/irqbalance enable || exit 1
fi

# The requested FRP client is installed but has no server or tunnel configuration.
# Do not enable an outbound client automatically before the owner configures it.
if [ -x /etc/init.d/frpc ]; then
	/etc/init.d/frpc disable || exit 1
fi

# UPnP stays disabled by package default. The existing XR1710G fan curve and
# automatic NCT7802 control remain unchanged.

exit 0
